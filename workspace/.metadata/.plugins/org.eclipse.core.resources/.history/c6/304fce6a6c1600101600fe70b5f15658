package com.bbva.servicioconversiondivisas.controllers;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.bbva.servicioconversiondivisas.dtos.ConvertirDivisasRequest;
import com.bbva.servicioconversiondivisas.dtos.ConvertirDivisasResponse;
import com.bbva.servicioconversiondivisas.services.ConvertirDivisasService;

@RestController
@RequestMapping("/api/convertir")
public class ConvertirDivisasController {

    @Autowired
    private ConvertirDivisasService service;

    /**
     * Endpoint para convertir divisas. Valida los campos de entrada y, en caso de
     * error, captura las excepciones que pueden originarse tanto en la validación 
     * como en la invocación de la API externa.
     *
     * @param request Datos de entrada para la conversión.
     * @return ResponseEntity con la conversión exitosa o el error correspondiente.
     */
    @PostMapping
    public ResponseEntity<?> convertir(@RequestBody ConvertirDivisasRequest request) {
        // Validación básica de los parámetros de entrada.
//        if (request.getMonto() == null || request.getMonedaOrigen() == null || request.getMonedaDestino() == null) {
//            return ResponseEntity.badRequest().body("Faltan parámetros obligatorios.");
//        }
        try {
            ConvertirDivisasResponse response = service.convertirDivisas(
                    request.getMonto(), 
                    request.getMonedaOrigen(), 
                    request.getMonedaDestino());
            return ResponseEntity.ok(response);
        } catch (IllegalArgumentException ex) {
            String message = ex.getMessage();
            // Si el mensaje de error hace referencia a la API externa, se retorna un 502 Bad Gateway.
            if (message != null && message.contains("API externa")) {
                return ResponseEntity.status(HttpStatus.BAD_GATEWAY)
                        .body("Error al conectar con la API externa: " + message);
            } else {
                return ResponseEntity.badRequest().body("ERROR " + message);
            }
        } catch (Exception ex) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body("Error en la ejecución del servicio: " + ex.getMessage());
        }
    }

    /**
     * Método global para capturar excepciones que no hayan sido manejadas en el método convertir.
     *
     * @param ex Excepción capturada.
     * @return ResponseEntity con el mensaje de error.
     */
    @ExceptionHandler(Exception.class)
    public ResponseEntity<String> handleException(Exception ex) {
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                .body("Error en la ejecución del servicio: " + ex.getMessage());
    }
}
