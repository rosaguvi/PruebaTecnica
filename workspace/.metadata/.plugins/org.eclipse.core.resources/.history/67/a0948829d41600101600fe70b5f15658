package com.bbva.servicioconversiondivisas.controllers;

import com.bbva.servicioconversiondivisas.dtos.ConvertirDivisasRequest;
import com.bbva.servicioconversiondivisas.dtos.ConvertirDivisasResponse;
import com.bbva.servicioconversiondivisas.services.ConvertirDivisasService;
import jakarta.validation.Valid;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.*;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.*;

/**
 * Controlador REST para la conversión de divisas.
 * Expone un endpoint para convertir un monto entre dos monedas usando una tasa de cambio actualizada.
 */
@RestController
@RequestMapping("/api/convertir")
@Validated
public class ConvertirDivisasController {

    private final ConvertirDivisasService service;

    /**
     * Constructor con inyección de dependencias.
     *
     * @param service servicio encargado de realizar la conversión
     */
    @Autowired
    public ConvertirDivisasController(ConvertirDivisasService service) {
        this.service = service;
    }

    /**
     * Endpoint POST que permite convertir un monto desde una moneda de origen a una moneda destino.
     *
     * @param request objeto con los datos de entrada (monto, monedaOrigen, monedaDestino)
     * @return respuesta con el monto convertido, la tasa y la fecha
     */
    @PostMapping
    public ResponseEntity<?> convertir(@Valid @RequestBody ConvertirDivisasRequest request) {

            ConvertirDivisasResponse response = service.convertirDivisas(
                    request.getMonto(),
                    request.getMonedaOrigen(),
                    request.getMonedaDestino());

            return ResponseEntity.ok(response);
    }
}
