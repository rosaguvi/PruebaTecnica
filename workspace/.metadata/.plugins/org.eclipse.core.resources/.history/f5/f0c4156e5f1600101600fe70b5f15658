package com.bbva.servicioconversiondivisas.controllers;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.bbva.servicioconversiondivisas.dtos.ConvertirDivisasRequest;
import com.bbva.servicioconversiondivisas.dtos.ConvertirDivisasResponse;
import com.bbva.servicioconversiondivisas.services.ConvertirDivisasService;

@RestController
@RequestMapping("/api/convertir")
public class ConvertirDivisasController {

    @Autowired
    private ConvertirDivisasService service;
    
    /**
     * Realiza la conversión de divisas validando que se reciba la información necesaria.
     * Si ocurre algún error, se captura y se retorna el error correspondiente.
     * 
     * @param request Los datos necesarios para realizar la conversión.
     * @return ResponseEntity que contiene la respuesta de la conversión o un mensaje de error.
     */
    @PostMapping
    public ResponseEntity<?> convertir(@RequestBody ConvertirDivisasRequest request) {
        // Validación básica de campos
        if (request.getMonto() == null || request.getMonedaOrigen() == null || request.getMonedaDestino() == null) {
            return ResponseEntity.badRequest().body("Faltan parámetros obligatorios.");
        }
        
        try {
            ConvertirDivisasResponse response = service.convertirDivisas(
                request.getMonto(), 
                request.getMonedaOrigen(), 
                request.getMonedaDestino()
            );
            return ResponseEntity.ok(response);
        } catch (IllegalArgumentException ex) {
            // Retornamos un error 400 si se lanza una IllegalArgumentException 
            return ResponseEntity.badRequest().body("Error: " + ex.getMessage());
        } catch (Exception ex) {
            // Para otros errores retornamos un error 500
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                                 .body("Error en la ejecución del servicio: " + ex.getMessage());
        }
    }
    
    /**
     * Método alternativo para capturar excepciones generales, en caso de que se desee centralizar la captura
     * de errores en el controlador. Este método se activaría en cualquier excepción no capturada por el bloque try/catch.
     *
     * @param ex La excepción capturada.
     * @return ResponseEntity con el error.
     */
    @ExceptionHandler(Exception.class)
    public ResponseEntity<String> handleException(Exception ex) {
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                             .body("Error en la ejecución del servicio: " + ex.getMessage());
    }
}
